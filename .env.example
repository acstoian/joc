# ── Joc Environment Variable Contract ──────────────────────────────────────
#
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.
#
# Key isolation rule (D-13):
#   NEXT_PUBLIC_*  → safe to expose in the browser bundle (anon key only)
#   All others     → server-only; never prefix with NEXT_PUBLIC_
#
# ── Client-exposed (browser-safe) ───────────────────────────────────────────

# Supabase project URL — visible in browser, safe (no secrets)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key — browser-safe with RLS enforcement
# Source: Supabase Dashboard → Project Settings → API Keys → anon/publishable
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only (NEVER use NEXT_PUBLIC_ prefix below this line) ─────────────

# Supabase service_role key — full DB bypass; server-only
# Source: Supabase Dashboard → Project Settings → API Keys → service_role/secret
SUPABASE_SERVICE_ROLE_KEY=

# Host password for the protected dashboard (D-15)
# Validated server-side only; never sent to the browser
HOST_PASSWORD=

# Supabase CLI personal access token — used by `supabase link` (non-interactive)
# Source: Supabase Dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
